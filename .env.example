# SATP_AI 환경변수 양식 (Git 업로드용 — 값 비움)
# 사용: 이 파일을 복사해 루트에 .env 로 저장한 뒤 값 입력
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux/macOS)

# --- 키움 실전 ---
KIWOOM_REAL_HOST_URL=https://api.kiwoom.com
KIWOOM_REAL_SOCKET_URL=wss://api.kiwoom.com:10000
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_APP_SECRET=

# --- 키움 모의 ---
KIWOOM_PAPER_HOST_URL=https://mockapi.kiwoom.com
KIWOOM_PAPER_SOCKET_URL=wss://mockapi.kiwoom.com:10000
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_APP_SECRET=

# --- 텔레그램 ---
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=

# --- Open DART (공시·재무 API, https://opendart.fss.or.kr/) ---
DART_API_KEY=

# --- FnSpace (예상실적 API, 유료 Data Mart — 현재 연동 스킵) ---
# FNSPACE_API_KEY=
# FNSPACE_ENABLE=N

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=thor_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
