    "body": [
      { "element": "inds_cd", "name_kr": "업종코드", "type": "String", "required": "Y", "length": "3", "description": "001:종합(KOSPI), 002:대형주, 003:중형주, 004:소형주, 101:종합(KOSDAQ), 201:KOSPI200, 302:KOSTAR, 701:KRX100 외 ※업종코드 참고" },
      { "element": "base_dt", "name_kr": "기준일자", "type": "String", "required": "Y", "length": "8", "description": "YYYYMMDD" }
    ]
  },
