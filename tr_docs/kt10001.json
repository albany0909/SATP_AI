{
  "api_information": {
    "api_id": "kt10001",
    "api_name": "주식 매도주문",
    "menu_path": "국내주식 > 주문 > 주식 매도주문(kt10001)",
    "method": "POST",
    "domain": {
      "production": "https://api.kiwoom.com",
      "mock": "https://mockapi.kiwoom.com"
    },
    "url": "/api/dostk/ordr",
    "format": "JSON",
    "content_type": "application/json;charset=UTF-8",
    "description": "주식 매도 주문을 요청합니다."
  },
  "request_spec": {
    "headers": [
      {
        "element": "api-id",
        "name_kr": "TR명",
        "type": "String",
        "required": "Y",
        "length": "10",
        "description": "8자리 TR코드, ex) ka00001, usa10099"
      },
      {
        "element": "authorization",
        "name_kr": "접근토큰",
        "type": "String",
        "required": "Y",
        "length": "1000",
        "description": "토큰 지정시 토큰타입(\"Bearer\") 붙혀서 호출 예) Bearer Egicyx..."
      },
      {
        "element": "cont-yn",
        "name_kr": "연속조회여부",
        "type": "String",
        "required": "N",
        "length": "1",
        "description": "응답 Header의 연속조회여부값이 Y일 경우 다음데이터 요청시 응답 Header의 cont-yn값 세팅"
      },
      {
        "element": "next-key",
        "name_kr": "연속조회키",
        "type": "String",
        "required": "N",
        "length": "50",
        "description": "응답 Header의 연속조회여부값이 Y일 경우 다음데이터 요청시 응답 Header의 next-key값 세팅"
      }
    ],
    "body": [
      {
        "element": "dmst_stex_tp",
        "name_kr": "국내거래소구분",
        "type": "String",
        "required": "Y",
        "length": "3",
        "description": "KRX, NXT, SOR"
      },
      {
        "element": "stk_cd",
        "name_kr": "종목코드",
        "type": "String",
        "required": "Y",
        "length": "12",
        "description": ""
      },
      {
        "element": "ord_qty",
        "name_kr": "주문수량",
        "type": "String",
        "required": "Y",
        "length": "12",
        "description": "단위: 1주"
      },
      {
        "element": "ord_uv",
        "name_kr": "주문단가",
        "type": "String",
        "required": "N",
        "length": "12",
        "description": "단위: 원"
      },
      {
        "element": "trde_tp",
        "name_kr": "매매구분",
        "type": "String",
        "required": "Y",
        "length": "2",
        "description": "0:보통, 3:시장가, 5: 조건부지정가, 81:장마감후시간외, 61:장시작전시간외, 62:시간외단일가, 6:최유리지정가, 7:최우선지정가, 10:보통(IOC), 13:시장가(IOC), 16:최유리(IOC), 20:보통(FOK), 23:시장가(FOK), 26:최유리(FOK), 28:스톱지정가, 29:중간가, 30:중간가(IOC), 31:중간가(FOK)"
      },
      {
        "element": "cond_uv",
        "name_kr": "조건단가",
        "type": "String",
        "required": "N",
        "length": "12",
        "description": "단위: 원"
      }
    ]
  },
  "response_spec": {
    "headers": [
      {
        "element": "api-id",
        "name_kr": "TR명",
        "type": "String",
        "required": "Y",
        "length": "10",
        "description": "8자리 TR코드, ex) ka00001, usa10099"
      },
      {
        "element": "cont-yn",
        "name_kr": "연속조회여부",
        "type": "String",
        "required": "N",
        "length": "1",
        "description": "다음 데이터가 있을시 Y값 전달"
      },
      {
        "element": "next-key",
        "name_kr": "연속조회키",
        "type": "String",
        "required": "N",
        "length": "50",
        "description": "다음 데이터가 있을시 다음 키값 전달"
      }
    ],
    "body": [
      {
        "element": "ord_no",
        "name_kr": "주문번호",
        "type": "String",
        "required": "N",
        "length": "7",
        "description": "7자리 주문번호 (취소 혹은 정정 주문 시 사용)"
      },
      {
        "element": "dmst_stex_tp",
        "name_kr": "국내거래소구분",
        "type": "String",
        "required": "N",
        "length": "6",
        "description": "KRX, NXT, SOR"
      },
      {
        "element": "return_code",
        "name_kr": "결과코드",
        "type": "Number",
        "required": "Y",
        "length": null,
        "description": "0: 정상 처리"
      },
      {
        "element": "return_msg",
        "name_kr": "결과메시지",
        "type": "String",
        "required": "Y",
        "length": null,
        "description": "처리 결과 메시지"
      }
    ]
  },
  "examples": {
    "request": {
      "dmst_stex_tp": "KRX",
      "stk_cd": "005930",
      "ord_qty": "1",
      "ord_uv": "",
      "trde_tp": "3",
      "cond_uv": ""
    },
    "response": {
      "ord_no": "0000138",
      "dmst_stex_tp": "KRX",
      "return_code": 0,
      "return_msg": "매도주문이 완료되었습니다."
    }
  },
  "notes_and_errors": {
    "usage_notes": [
      "운영 환경(https://api.kiwoom.com)과 모의투자 환경(https://mockapi.kiwoom.com) 도메인을 확인하여 호출해야 합니다.",
      "매매구분(trde_tp)에 따라 시장가, 지정가, 조건부지정가, IOC/FOK 등의 옵션을 선택할 수 있습니다."
    ]
  }
}