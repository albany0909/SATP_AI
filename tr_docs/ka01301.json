      "mock": "https://mockapi.kiwoom.com"
    },
    "url": "/api/dostk/watchlist",
    "format": "JSON",
    "content_type": "application/json;charset=UTF-8",
    "description": "국내주식 관심종목 그룹에 속한 종목 리스트를 조회합니다."
  },
  "request": {
    "headers": [
      {
        "element": "api-id",
        "name_kr": "TR명",
        "type": "String",
        "required": "Y",
        "length": 10,
        "description": "8자리 TR코드 (ex: ka01301)"
      },
      {
        "element": "authorization",
        "name_kr": "접근토큰",
        "type": "String",
        "required": "Y",
        "length": 1000,
        "description": "토큰 지정시 토큰타입('Bearer') 붙여서 호출 예) Bearer Egicyx..."
      },
      {
        "element": "cont-yn",
        "name_kr": "연속조회여부",
        "type": "String",
        "required": "N",
        "length": 1,
        "description": "응답 Header의 연속조회여부값이 Y일 경우 다음데이터 요청시 응답 Header의 cont-yn값 세팅"
      },
      {
        "element": "next-key",
        "name_kr": "연속조회키",
        "type": "String",
        "required": "N",
        "length": 50,
        "description": "응답 Header의 연속조회여부값이 Y일 경우 다음데이터 요청시 응답 Header의 next-key값 세팅"
      }
    ],
    "body": [
      {
        "element": "arn_grp_id",
        "name_kr": "그룹SEQ",
        "type": "String",
        "required": "Y",
        "length": 3,
        "description": "ka01300 응답 결과의 gcod값을 입력"
      }
    ]
  },
  "response": {
    "headers": [
      {
        "element": "api-id",
        "name_kr": "TR명",
        "type": "String",
        "required": "Y",
        "length": 10,
        "description": "8자리 TR코드"
      },
      {
        "element": "cont-yn",
        "name_kr": "연속조회여부",
        "type": "String",
        "required": "N",
        "length": 1,
        "description": "다음 데이터가 있을시 Y값 전달"
      },
      {
        "element": "next-key",
        "name_kr": "연속조회키",
        "type": "String",
        "required": "N",
        "length": 50,
        "description": "다음 데이터가 있을시 다음 키값 전달"
      }
    ],
    "body": [
      {
        "element": "rtcd",
        "name_kr": "처리 결과",
        "type": "String",
        "required": "N",
        "length": 1,
        "description": "S:성공 F:실패"
      },
      {
        "element": "nofj",
        "name_kr": "종목 갯수",
        "type": "List<Map>",
        "required": "N",
        "length": null,
        "description": "그룹 내 종목 목록"
      },
      {
        "element": "- cod2",
        "name_kr": "종목코드",
        "type": "String",
        "required": "N",
        "length": 18,
        "description": "그룹 내 포함된 종목코드"
      },
      {
        "element": "- bgb",
        "name_kr": "북마크 구분",
        "type": "String",
        "required": "N",
        "length": 1,
        "description": "북마크 여부 플래그"
      },
      {
        "element": "- bgb_clr",
        "name_kr": "북마크 컬러",
        "type": "String",
        "required": "N",
        "length": 9,
        "description": "북마크 지정 컬러값"
      }
    ]
  },
  "examples": {
    "request": {
      "arn_grp_id": "001"
    },
    "response": {
      "rtcd": "S",
      "nofj": [
        {
          "cod2": "039490",
          "bgb": "0",
          "bgb_clr": ""
        },
        {
          "cod2": "138930",
          "bgb": "0",
          "bgb_clr": ""
        }
      ],
      "return_code": 0,
      "return_msg": "정상적으로 처리되었습니다"
    }
  },
  "notes": [
    "ka01300 TR을 통해 조회된 그룹코드(gcod)를 arn_grp_id 파라미터에 매핑하여 호출합니다."
  ]
}