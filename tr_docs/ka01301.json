{
  "api_info": {
    "api_id": "ka01301",
    "api_name": "관심종목 그룹 상세 조회",
    "menu_path": "국내주식 > 관심종목 > 관심종목 그룹 상세 조회(ka01301)",
    "method": "POST",
    "domain": {
