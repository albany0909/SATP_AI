{
  "api_information": {
    "api_id": "kt10003",
    "api_name": "주식 취소주문",
    "menu_path": "국내주식 > 주문 > 주식 취소주문(kt10003)",
    "method": "POST",
    "domain": {
      "production": "https://api.kiwoom.com",
      "mock": "https://mockapi.kiwoom.com"
    },
    "url": "/api/dostk/ordr",
    "format": "JSON",
    "content_type": "application/json;charset=UTF-8",
    "description": "주식 취소 주문을 요청합니다."
  },
  "request_spec": {
    "headers": [
      {
        "element": "api-id",
        "name_kr": "TR명",
        "type": "String",
        "required": "Y",
        "length": "10",
        "description": "8자리 TR코드, ex) ka00001, usa10099"
      },
      {
        "element": "authorization",
        "name_kr": "접근토큰",
        "type": "String",
        "required": "Y",
        "length": "1000",
        "description": "토큰 지정시 토큰타입(\"Bearer\") 붙혀서 호출 예) Bearer Egicyx..."
      },
      {
        "element": "cont-yn",
        "name_kr": "연속조회여부",
        "type": "String",
        "required": "N",
        "length": "1",
        "description": "응답 Header의 연속조회여부값이 Y일 경우 다음데이터 요청시 응답 Header의 cont-yn값 세팅"
      },
      {
        "element": "next-key",
        "name_kr": "연속조회키",
        "type": "String",
        "required": "N",
        "length": "50",
        "description": "응답 Header의 연속조회여부값이 Y일 경우 다음데이터 요청시 응답 Header의 next-key값 세팅"
      }
    ],
    "body": [
      {
        "element": "dmst_stex_tp",
        "name_kr": "국내거래소구분",
        "type": "String",
        "required": "Y",
        "length": "3",
        "description": "KRX,NXT,SOR"
      },
      {
        "element": "orig_ord_no",
        "name_kr": "원주문번호",
        "type": "String",
        "required": "Y",
        "length": "7",
        "description": "매수/매도 주문 요청 응답 결과로 받은 7자리 주문번호"
      },
      {
        "element": "stk_cd",
        "name_kr": "종목코드",
        "type": "String",
        "required": "Y",
        "length": "12",
        "description": "종목코드"
      },
      {
        "element": "cncl_qty",
        "name_kr": "취소수량",
        "type": "String",
        "required": "Y",
        "length": "12",
        "description": "단위: 1주, '0' 입력시 잔량 전부 취소"
      }
    ]
  },
  "response_spec": {
    "headers": [
      {
        "element": "api-id",
        "name_kr": "TR명",
        "type": "String",
        "required": "Y",
        "length": "10",
        "description": "8자리 TR코드, ex) ka00001, usa10099"
      },
      {
        "element": "cont-yn",
        "name_kr": "연속조회여부",
        "type": "String",
        "required": "N",
        "length": "1",
        "description": "다음 데이터가 있을시 Y값 전달"
      },
      {
        "element": "next-key",
        "name_kr": "연속조회키",
        "type": "String",
        "required": "N",
        "length": "50",
        "description": "다음 데이터가 있을시 다음 키값 전달"
      }
    ],
    "body": [
      {
        "element": "ord_no",
        "name_kr": "주문번호",
        "type": "String",
        "required": "N",
        "length": "7",
        "description": "새 주문번호"
      },
      {
        "element": "base_orig_ord_no",
        "name_kr": "모주문번호",
        "type": "String",
        "required": "N",
        "length": "7",
        "description": "원 주문번호"
      },
      {
        "element": "cncl_qty",
        "name_kr": "취소수량",
        "type": "String",
        "required": "N",
        "length": "12",
        "description": "단위: 1주, 좌측 0-padding 처리된 부호 포함 12자리 숫자"
      }
    ]
  },
  "examples": {
    "request": {
      "dmst_stex_tp": "KRX",
      "orig_ord_no": "0000140",
      "stk_cd": "005930",
      "cncl_qty": "1"
    },
    "response": {
      "ord_no": "0000141",
      "base_orig_ord_no": "0000139",
      "cncl_qty": "000000000001",
      "return_code": 0,
      "return_msg": "매수취소 주문입력이 완료되었습니다"
    }
  },
  "notes_and_errors": {
    "usage_notes": [
      "운영 환경(https://api.kiwoom.com)과 모의투자 환경(https://mockapi.kiwoom.com) 도메인을 확인하여 호출해야 합니다.",
      "요청 body는 dmst_stex_tp, orig_ord_no, stk_cd, cncl_qty 네 필드만 사용한다.",
      "orig_ord_no 는 매수(kt10000)·매도(kt10001) 응답의 ord_no(7자리)를 그대로 넣는다.",
      "cncl_qty 에 '0' 을 넣으면 원주문의 미체결 잔량을 전부 취소한다."
    ]
  }
}
